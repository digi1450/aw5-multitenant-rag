# Keep aw5_backend/.env local and ignored. Generate independent random values.
AW5_POSTGRES_PASSWORD=
AW5_DIFY_READ_URL=postgresql://aw5_sync_reader:CHANGE_ME@db_postgres:5432/dify
AW5_DISCORD_BOT_TOKEN=
AW5_BACKEND_BOT_TOKEN=
AW5_BACKEND_ADMIN_TOKEN=
AW5_BACKEND_ENCRYPTION_KEY=
AW5_DIFY_KNOWLEDGE_API_BASE_URL=http://api:5001/v1
AW5_DIFY_KNOWLEDGE_API_KEY=
AW5_DISCORD_GUILD_ID=
# Bot Compose settings are read from this env file through an explicit allowlist.
AW5_DISCORD_START_CHANNEL_ID=

# Configure both to enable the local Discord administrator portal.
AW5_DISCORD_ADMIN_CHANNEL_ID=
AW5_DISCORD_ADMIN_ROLE_ID=
AW5_ADMIN_PORTAL_ORIGIN=http://127.0.0.1:8765
