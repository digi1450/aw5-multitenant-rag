        </mxCell>
        <mxCell id="user" value="&lt;b&gt;Organization user&lt;/b&gt;&lt;br&gt;Project member or project admin&lt;br&gt;&lt;font color='#64748b'&gt;Private personal conversation&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
