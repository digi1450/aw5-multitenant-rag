        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Authorization Service&lt;/b&gt;&lt;br&gt;Derive tenant_id and role&lt;br&gt;&lt;font color='#9a3412'&gt;Fail closed before retrieval&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=1.5;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
