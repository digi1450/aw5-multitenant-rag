# For a host/Terminal bot run only; Docker reads allowlisted settings from aw5_backend/.env.
# Keep only Discord/backend settings here, never Dify keys or registry paths.
AW5_DISCORD_BOT_TOKEN=
AW5_DISCORD_GUILD_ID=1553804321160953937
AW5_DISCORD_START_CHANNEL_ID=1553807597826736188
AW5_STATE_DB=output/discord-bot/aw5.sqlite3
AW5_BACKEND_API_URL=http://127.0.0.1:8765
AW5_BACKEND_BOT_TOKEN=

# Channel where /aw5-admin is allowed; backend checks the admin role.
AW5_DISCORD_ADMIN_CHANNEL_ID=
