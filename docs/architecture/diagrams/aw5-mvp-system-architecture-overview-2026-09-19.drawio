        </mxCell>
        <mxCell id="teams" value="&lt;b&gt;Microsoft Teams&lt;/b&gt;&lt;br&gt;Personal bot conversation&lt;br&gt;&lt;font color='#64748b'&gt;Questions in • answers + citations out&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f3f0ff;strokeColor=#818cf8;strokeWidth=1.5;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="350" width="265" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;Single sign-on identity&lt;br&gt;&lt;font color='#64748b'&gt;Stable organization user ID&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
