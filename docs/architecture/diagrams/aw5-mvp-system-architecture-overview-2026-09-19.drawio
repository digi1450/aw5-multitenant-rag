          <mxGeometry x="425" y="365" width="240" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="conversation" value="&lt;b&gt;Conversation Service&lt;/b&gt;&lt;br&gt;Private session mapping&lt;br&gt;&lt;font color='#64748b'&gt;platform_user_id + tenant_id&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="705" y="365" width="245" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Dify Gateway&lt;/b&gt;&lt;br&gt;Trusted tenant → Dify app mapping&lt;br&gt;&lt;font color='#047857'&gt;Server-side credentials • authorized requests only&lt;/font&gt;&lt;br&gt;&lt;font color='#64748b'&gt;MVP: one Dify app per project tenant&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=1.5;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="425" y="505" width="525" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="observe" value="&lt;b&gt;Operational Observability&lt;/b&gt;&lt;br&gt;Cross-cutting monitoring for AW5 backend and Dify&lt;br&gt;&lt;font color='#64748b'&gt;Authorization • latency • tokens • provider errors • estimated cost&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#1d4ed8'&gt;&lt;b&gt;No AW5 per-user query or token quota&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748b'&gt;Per-request timeout and bounded retry remain safeguards.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="425" y="655" width="525" height="145" as="geometry"/>
        </mxCell>

