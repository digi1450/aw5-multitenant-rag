        </mxCell>
        <mxCell id="graph" value="&lt;b&gt;Microsoft Graph&lt;/b&gt;&lt;br&gt;Membership and role changes&lt;br&gt;&lt;font color='#64748b'&gt;Owner → project_admin&lt;br&gt;Member → project_member&lt;br&gt;Guest → denied by default&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="615" width="265" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="aw5-zone" value="&lt;b&gt;Trusted AW5 Application Boundary&lt;/b&gt;&lt;br&gt;&lt;font color='#64748b' style='font-size:11px'&gt;PROPOSED MVP • AUTHORIZATION DECISION POINT&lt;/font&gt;" style="swimlane;html=1;rounded=1;arcSize=4;startSize=65;horizontal=1;fillColor=#eaf2ff;swimlaneFillColor=#ffffff;strokeColor=#60a5fa;strokeWidth=2.5;fontSize=18;fontColor=#0f172a;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="400" y="125" width="580" height="735" as="geometry"/>
        </mxCell>
        <mxCell id="adapter" value="&lt;b&gt;Teams Bot Adapter&lt;/b&gt;&lt;br&gt;Public HTTPS ingress&lt;br&gt;&lt;font color='#64748b'&gt;Verify request and token • render citations&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fbff;strokeColor=#bfdbfe;fontColor=#172033;fontSize=14;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
